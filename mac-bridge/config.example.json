{
  "_comment": "Copy to ~/.config/mac-bridge/config.json. Never commit real secrets. steward_webhook means Feishu assistant wake URL (legacy key name).",
  "feishu": {
    "app_id": "cli_xxxxxxxx",
    "app_secret_file": "~/.config/mac-bridge/feishu_app_secret",
    "bot_open_id_file": "~/.config/mac-bridge/bot_open_id",
    "inbox_dir": "~/.config/mac-bridge/data",
    "qa_ingest": {
      "enabled": false,
      "script": "/path/to/optional/ingest.py",
      "db": "~/.config/mac-bridge/data/feishu_qa.sqlite3"
    },
    "steward_webhook": {
      "url_file": "~/.config/mac-bridge/steward_webhook_url",
      "auth_file": "~/.config/mac-bridge/steward_webhook_auth"
    },
    "bot_name_re": "飞书答疑|Feishu|Grok Bot|bot管家|Steward",
    "follow_chat_ids": []
  },
  "yunxiao": {
    "listen_host": "127.0.0.1",
    "listen_port": 8787,
    "path": "/yunxiao/codeup",
    "shared_secret_file": "~/.config/mac-bridge/yunxiao_ingress_secret",
    "quality_webhook": {
      "url_file": "~/.config/mac-bridge/quality_webhook_url",
      "auth_file": "~/.config/mac-bridge/quality_webhook_auth"
    }
  }
}
